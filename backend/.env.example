# ═══════════════════════════════════════════════════════════════════════════════
# EDUVILLAGE BACKEND - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git - it's in .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# Node environment: development, staging, or production
NODE_ENV=development

# Port the server runs on
# Render will override this with PORT from their environment
PORT=5000


# ──────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# Get this from MongoDB Atlas dashboard
MONGO_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/eduvillage?retryWrites=true&w=majority&appName=Cluster0

# MongoDB Database Name (optional, can be in MONGO_URI)
MONGO_DB_NAME=eduvillage


# ──────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ──────────────────────────────────────────────────────────────────────────────

# JWT Secret Key (use a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Token Expiration (e.g., 7d, 24h, 1d)
JWT_EXPIRY=7d

# Session Secret (for cookies)
SESSION_SECRET=your_session_secret_change_this_in_production


# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION (CORS)
# ──────────────────────────────────────────────────────────────────────────────

# Frontend URL for CORS configuration
# Development: http://localhost:3000 or http://localhost:5173
# Production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# Alternative frontend URL (for fallback)
FRONTEND_URL=http://localhost:3000


# ──────────────────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (Optional - for notifications)
# ──────────────────────────────────────────────────────────────────────────────

# Gmail or other SMTP configuration
# For Gmail, use App Password (not regular password)
# See: https://support.google.com/accounts/answer/185833
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_not_regular_password


# ──────────────────────────────────────────────────────────────────────────────
# LOGGING & MONITORING (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Enable request logging
LOG_REQUESTS=true


# ──────────────────────────────────────────────────────────────────────────────
# THIRD-PARTY SERVICES (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Add any other API keys or service URLs here
# STRIPE_API_KEY=
# CLOUDINARY_API_KEY=
# etc.
